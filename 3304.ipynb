    "k = int(input())\n",
    "s='a'\n",
    "for i in range(k):\n",
    "    s1 = \"\"\n",
    "    for i in range(len(s)+1):\n",
    "        ne = ord(s[i-1])+1\n",
    "        s1 = s1 + chr(ne)\n",
    "    s = s+s1\n",
    "    print(s)\n",
    "    if len(s)>=k:\n",
    "        print(s[k-1])\n",
    "        break"
