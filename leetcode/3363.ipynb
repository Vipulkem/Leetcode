   "source": [
    "fruits = [[1,2,3,4],[5,6,8,7],[9,10,11,12],[13,14,15,16]]\n",
    "\n",
    "n = len(fruits)\n",
    "sum = 0\n",
    "for i in range(len(fruits)):\n",
    "    sum = sum + fruits[i][i]\n",
    "    if i<n-1:\n",
    "        sum = sum + fruits[i][n-1] + fruits [n-1][i]\n",
    "    print(fruits[i][i],fruits[i][n-1],fruits[n-1][i])\n",
    "print(sum)"
   ]
